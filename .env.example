# Copy to .env and fill in, then `source .env`.

# Cloudflare R2 credentials (S3-compatible names) for `uv run fetch` and training.
AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=hal
WANDB_API_KEY=

# Optional path overrides. Defaults are under <repo>/data/, where `uv run fetch` writes.
# HAL_ISO_PATH=...
# HAL_EMULATOR_PATH=...
# HAL_NETPLAY_EMULATOR_PATH=...
# HAL_DEV_ARCHIVE=...
# HAL_DEV_MDS_DIR=...
