# Keep the build context lean and free of secrets/fixtures. Datasets, the
# emulator, runs, and the host venv are mounted/fetched at runtime, never baked.
.git
.agents
.claude
.codex
.orca/
.venv
.o*-launch-*/
data/
results/
replays/
runs/
wandb/
Logs/
logs/
notebooks/
web/**/node_modules/
web/**/.next/
.env
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
**/*.ipynb
