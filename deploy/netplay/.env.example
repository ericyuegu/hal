HAL_GIT_SHA=<full deployed commit>
HAL_NETPLAY_API_URL=https://20xx.xyz
HAL_NETPLAY_RUNNER_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
HAL_NETPLAY_SLOTS=1
HAL_NETPLAY_SLIPPI_PORT=51441
HAL_NETPLAY_GRAPHICS_BACKEND=Vulkan
HAL_NETPLAY_DISPLAY_BASE=100
HAL_NETPLAY_STREAM=1
# Owner-gated manual Twitch checks only. Never test a stream without this set to 1.
HAL_TWITCH_BANDWIDTH_TEST=0

AWS_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=hal

# Local development only. Files are addressed by the R2 keys returned by the Worker.
HAL_NETPLAY_LOCAL_ASSETS=
HAL_NETPLAY_ADMIN_TOKEN=dev-admin-token
HAL_NETPLAY_LOCAL_STREAM=0
HAL_NETPLAY_LOCAL_TWITCH_KEY=
